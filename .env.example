LLM_API_KEY=your-gemini-api-key-here
DISCORD_TOKEN=your-discord-bot-token-here
ADMIN_USER_ID=your-discord-user-id-here
CHANNEL_ID=your-channel-id-here
GUILD_ID=your-guild-id-here
TICK_TIME_S=3600
MAX_JOBS=10
MAX_JOB_QUEUE=30
# Auto job generation: when the backlog queue (queued + in-flight) drops to
# JOB_GEN_LOW_THRESHOLD or below, the create_jobs tick phase generates enough
# jobs to refill it to JOB_GEN_HIGH_THRESHOLD. Generation only runs once the
# quest description LLM memory holds at least JOB_GEN_MIN_HISTORY_MSGS messages
# (each prior job adds a user+assistant pair, so 6 ~= 3 past jobs).
JOB_GEN_LOW_THRESHOLD=3
JOB_GEN_HIGH_THRESHOLD=10
JOB_GEN_MIN_HISTORY_MSGS=6
ACTIVITY_LOG_MAX_LINES=4
ACTIVITY_LOG_DEBOUNCE_MS=5000
