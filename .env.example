LLM_API_KEY=your-gemini-api-key-here
DISCORD_TOKEN=your-discord-bot-token-here
ADMIN_USER_ID=your-discord-user-id-here
CHANNEL_ID=your-channel-id-here
GUILD_ID=your-guild-id-here
TICK_TIME_S=3600
MAX_JOBS=10
MAX_JOB_QUEUE=30
# Player-submitted job backlog only (/generate_job, /write_job). Auto jobs go
# directly on the board during the refill tick phase.
# Empty board slots held open for chudmaster submissions before auto-fill runs.
RESERVED_CM_SLOT_NUM=3
# Auto board jobs only generate once the quest description LLM memory holds at
# least JOB_GEN_MIN_HISTORY_MSGS messages (each prior job adds a user+assistant
# pair, so 4 ~= 2 past jobs).
JOB_GEN_MIN_HISTORY_MSGS=4
# Clear global job LLM memory (description + trials) after this many job
# generations. Set to 0 to disable. Story job memory is excluded and persists
# for the play session (trimmed only by the char-budget limit).
JOB_MEMORY_RESET_AFTER=10
# Clear per-chud quest result LLM memory after this many result generations
# for that chud. Set to 0 to disable.
RESULT_MEMORY_RESET_AFTER=5
# Idle regular jobs are recycled to the queue after this many ticks on the board.
JOB_TIMEOUT_TICK=10
# Active quest ticks_remaining decremented by this amount each board tick.
# Higher values finish multi-trial jobs faster (default 1).
JOBS_PER_TICK=1
ACTIVITY_LOG_MAX_LINES=4
ACTIVITY_LOG_DEBOUNCE_MS=5000
